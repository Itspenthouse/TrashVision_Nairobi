# Copy this file to `.env` and adjust as needed. NEVER commit the real .env.
# These names mirror the fields in app/config.py; setting them here overrides
# the code defaults without touching code.

# --- Model ---
# Demo default is the pretrained nano model (auto-downloaded on first run).
MODEL_WEIGHTS=yolov8n.pt
MODEL_VERSION=pretrained-yolov8n-coco-proxy-v0

# After you train your own model, switch to:
# MODEL_WEIGHTS=training/runs/detect/trashvision/weights/best.pt
# MODEL_VERSION=trashvision-yolov8n-v1
# USE_COCO_PROXY=false

# Throw away detections the model is less than this sure about (0..1).
CONFIDENCE_THRESHOLD=0.25

# true  = pretrained demo mode (map COCO food classes -> organic_waste)
# false = your fine-tuned model that already outputs the 3 real classes
USE_COCO_PROXY=true

# Reject uploads larger than this many megabytes.
MAX_IMAGE_MB=10
